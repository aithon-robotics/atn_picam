[Unit]
Description=Jetson Camera Stream and Recording Server
After=network.target

[Service]
Type=simple
User=atn
WorkingDirectory=/home/atn/aithon_code/atn_picam
Environment="PYTHONPATH=/home/atn/aithon_code/atn_picam/src"
ExecStart=/home/atn/aithon_code/atn_picam/venv/bin/python3 -m atn_picam.jetson.stream
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Optional: Set environment variables if needed
# Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
